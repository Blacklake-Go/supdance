FROM oven/bun:1.4.3 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile
COPY server server
COPY shared shared
RUN bun build server/issuer-main.ts --target=node --packages=external --outfile=issuer.mjs

FROM node:24-alpine
WORKDIR /app
RUN mkdir /data && chown node:node /data
COPY --from=build --chown=node:node /app/node_modules node_modules
COPY --from=build --chown=node:node /app/issuer.mjs issuer.mjs
USER node
ENV SUPDANCE_PLUGIN_ISSUER_DATABASE=/data/issuer.sqlite
EXPOSE 8788
HEALTHCHECK --interval=5s --timeout=3s --start-period=3s CMD node --input-type=module -e 'if (!(await fetch("http://127.0.0.1:8788/healthz")).ok) process.exit(1)'
CMD ["node", "issuer.mjs"]
