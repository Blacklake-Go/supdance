# For local UI and protocol discovery only. Omit this flag in all public environments.
SUPDANCE_PLUGIN_DEV=1
SUPDANCE_PLUGIN_PORT=8787
SUPDANCE_PLUGIN_ORIGIN=http://127.0.0.1:8787
# Production MCP origin: https://www.supdance.com
# Production web defaults to /supdance-studio. Set a separate web origin to isolate browser sessions.
# SUPDANCE_PLUGIN_WEB_ORIGIN=
# SUPDANCE_PLUGIN_WEB_BASE=/supdance-studio
SUPDANCE_PLUGIN_DATABASE=./data/plugin.sqlite
# Supply the resource-capable OAuth issuer and explicit HTTPS endpoints.
SUPDANCE_PLUGIN_OAUTH_ISSUER=
SUPDANCE_PLUGIN_OAUTH_AUTHORIZATION=
SUPDANCE_PLUGIN_OAUTH_TOKEN=
SUPDANCE_PLUGIN_OAUTH_INTROSPECTION=
SUPDANCE_PLUGIN_INTROSPECTION_ID=
SUPDANCE_PLUGIN_INTROSPECTION_SECRET=
SUPDANCE_PLUGIN_WEB_CLIENT_ID=
SUPDANCE_PLUGIN_WEB_CLIENT_SECRET=
SUPDANCE_PLUGIN_SESSION_KEY=
# Versioned server-to-server partner API. Use the base URL before /v1.
SUPDANCE_PLUGIN_BRIDGE_URL=
SUPDANCE_PLUGIN_BRIDGE_SECRET=
SUPDANCE_PLUGIN_REVIEW_SUBJECT=
# Enable only after the host implements preview, commit, and idempotent project creation.
SUPDANCE_PLUGIN_PROJECTS_WRITE_ENABLED=0
# Keep off on the public OpenAI listing pending credit entitlement review.
SUPDANCE_PLUGIN_MEDIA_ENABLED=0
